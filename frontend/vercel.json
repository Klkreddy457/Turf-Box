{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://turf-box.vercel.app/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://turf-box.vercel.app/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
